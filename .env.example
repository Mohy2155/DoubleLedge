# Database
DB_NAME=doubleledge
DB_USER=ledger_runtime
DB_PASSWORD=replace_with_secure_runtime_password
DB_HOST=db
DB_PORT=5432
POSTGRES_PASSWORD=replace_with_secure_admin_password
LEDGER_RUNTIME_PASSWORD=replace_with_secure_runtime_password
# Optional read replica for statements / balances (set by docker-compose.replica.yml for the api)
# DB_REPLICA_HOST=db_replica
# DB_REPLICA_PORT=5432
# READ_REPLICA_MAX_LAG_SECONDS=5

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Application Security
SECRET_KEY=replace-this-with-a-secure-secret-key
DEBUG=True
ALLOWED_HOSTS=*
REQUIRE_RESTRICTED_DB_ROLE=1

